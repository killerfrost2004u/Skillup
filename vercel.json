{
  "version": 2,
  "builds": [
    {
      "src": "Backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "Frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/app.py"
    },
    {
      "src": "/register",
      "dest": "Backend/app.py"
    },
    {
      "src": "/login",
      "dest": "Backend/app.py"
    },
    {
      "src": "/chat",
      "dest": "Backend/app.py"
    },
    {
      "src": "/update-profile",
      "dest": "Backend/app.py"
    },
    {
      "src": "/courses",
      "dest": "Backend/app.py"
    },
    {
      "src": "/get-progress/(.*)",
      "dest": "Backend/app.py"
    },
    {
      "src": "/health",
      "dest": "Backend/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "Frontend/$1"
    }
  ]
}
