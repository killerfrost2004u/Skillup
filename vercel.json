{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "Frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/register", "dest": "api/index.py" },
    { "src": "/login", "dest": "api/index.py" },
    { "src": "/chat", "dest": "api/index.py" },
    { "src": "/update-profile", "dest": "api/index.py" },
    { "src": "/courses", "dest": "api/index.py" },
    { "src": "/get-progress/(.*)", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/", "dest": "Frontend/index.html" },
    { "src": "/(.*)", "dest": "Frontend/$1" }
  ]
}
